// PlayLe — Prisma schema
//
// Phase 2 introduces the first real domain models: User identity and
// authentication (refresh token) state. See docs/database/README.md and
// docs/decisions/ADR-011-authentication.md for the reasoning behind the
// shapes below. The full business schema (wallet, ledger, matches, social
// graph, etc.) is still designed in later, dedicated phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  /// Exactly one row (the seeded platform/system account — see
  /// docs/decisions/ADR-016-match-financial-architecture.md). Never a
  /// normal player: `status` is `DISABLED`, which already blocks it from
  /// login (JwtAuthGuard's status check) and from challenge-opponent
  /// selection (ChallengesService requires `status: 'ACTIVE'`) with no
  /// extra checks needed.
  SYSTEM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/// Core identity record. One row per account. Never return `passwordHash`
/// from an API response — see `src/users/users.service.ts` `toSafeUser`.
model User {
  id          String  @id @default(uuid())
  email       String  @unique
  phoneNumber String? @unique

  username    String  @unique
  displayName String?
  avatarUrl   String?

  passwordHash String

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  dateOfBirth DateTime

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  wallet        Wallet?
  deposits      Deposit[]
  withdrawals   Withdrawal[]

  ledgerAdjustmentsAuthored LedgerEntry[] @relation("LedgerAdjustmentAdmin")
  withdrawalReviewsAuthored Withdrawal[]  @relation("WithdrawalReviewAdmin")

  matchPlayers          MatchPlayer[]
  matchesWon            Match[]        @relation("MatchWinner")
  pendingDrawOffersMade Match[]        @relation("MatchPendingDrawOfferBy")
  matchCommands         MatchCommand[]
  challengesSent        Challenge[]    @relation("ChallengeChallenger")
  challengesReceived    Challenge[]    @relation("ChallengeOpponent")

  matchStakePlayers MatchStakePlayer[]
  settlementEntries SettlementEntry[]
  disputesRaised    Dispute[]          @relation("DisputeRaisedBy")
  disputesResolved  Dispute[]          @relation("DisputeResolvedBy")

  passwordResetTokens           PasswordResetToken[]
  verificationChallenges        VerificationChallenge[]
  mfaTotpCredential             MfaTotpCredential?
  responsibleGamingRestrictions ResponsibleGamingRestriction[]
  notifications                 NotificationOutbox[]
  paymentAnomaliesResolved      PaymentReconciliationAnomaly[] @relation("PaymentAnomalyResolvedAdmin")
  adminAuditLogs                AdminAuditLog[]

  @@map("users")
}

/// Refresh-token session state, supporting rotation and reuse detection.
/// The raw refresh token is never persisted — only a SHA-256 hash of it
/// (see `src/auth/token.service.ts`). `familyId` groups every token
/// descended from a single login: rotating issues a new row in the same
/// family; presenting an already-revoked token (reuse of a stale token,
/// e.g. a stolen one) revokes the whole family, logging out every device
/// descended from that login.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash      String    @unique
  familyId       String
  replacedByHash String?
  revokedAt      DateTime?

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Phase 3 — Wallet, Ledger & Financial Foundation
//
// Money is always an integer count of minor units (1 SLE = 100 minor units,
// i.e. cents) stored as `BigInt`/Postgres `bigint`. Never a float. See
// docs/decisions/ADR-012-financial-architecture.md for the full reasoning.
//
// The only code path allowed to change a Wallet's balances or insert a
// LedgerEntry is `LedgerService.applyEntry` (apps/api/src/ledger/ledger.service.ts).
// No other service may call `wallet.update(...)` or `ledgerEntry.create(...)`
// directly. Financial relations use `onDelete: Restrict` — a user with any
// financial history can never be deleted, by design.
// ---------------------------------------------------------------------------

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  HOLD
  RELEASE
  REFUND
  ADJUSTMENT
  /// A player's match stake moving from available to held
  /// (Phase 5 — see docs/decisions/ADR-016-match-financial-architecture.md).
  STAKE_HOLD
  /// A held match stake returned to available with no game result (match
  /// cancelled, or a draw) — Phase 5.
  STAKE_REFUND
  /// A losing player's held match stake consumed by settlement (held -= 0,
  /// no available credit) — Phase 5.
  STAKE_LOSS
  /// A settlement payout credited to the winner (their own stake back
  /// plus net winnings) — reserved since Phase 3, produced starting
  /// Phase 5.
  PRIZE
  /// PlayLe's platform fee, credited to the system/platform account —
  /// reserved since Phase 3, produced starting Phase 5. This is PlayLe's
  /// product fee, not a government tax — see ADR-016.
  PLATFORM_FEE
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  /// The provider-side payment code/session expired before the user paid
  /// (Phase 6 — real-provider deposits only; a MANUAL deposit never
  /// reaches this state).
  EXPIRED
}

enum WithdrawalStatus {
  PENDING_REVIEW
  APPROVED
  /// Submitted to the payout provider; outcome not yet confirmed (Phase
  /// 6). A withdrawal can sit here for an extended period if the
  /// provider's own outcome is unknown (e.g. after an HTTP timeout) — see
  /// docs/decisions/ADR-019-production-payments.md. Funds stay held;
  /// nothing is released or re-submitted automatically from this state.
  PROCESSING
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  REJECTED
}

/// One unified wallet per user. `availableBalanceMinor` can be spent/
/// withdrawn; `heldBalanceMinor` is reserved (e.g. a pending withdrawal)
/// and cannot. Both are enforced non-negative at the application layer
/// (LedgerService) and at the database layer (CHECK constraints added by
/// hand to the generated migration).
model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  availableBalanceMinor BigInt @default(0)
  heldBalanceMinor      BigInt @default(0)
  currency              String @default("SLE")

  ledgerEntries LedgerEntry[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

/// Immutable, append-only financial audit log. Every row is one atomic
/// balance-affecting event. `availableDeltaMinor`/`heldDeltaMinor` are
/// signed and may both be non-zero in the same row (e.g. a HOLD moves
/// money from available to held in one event). `*BalanceAfterMinor` is a
/// snapshot of the resulting wallet state, so a row is self-describing
/// without needing to replay history. Never updated or deleted after
/// creation — there is deliberately no update/delete method for this
/// model anywhere in the service layer.
model LedgerEntry {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  userId   String

  type LedgerEntryType

  availableDeltaMinor BigInt
  heldDeltaMinor      BigInt

  availableBalanceAfterMinor BigInt
  heldBalanceAfterMinor      BigInt

  currency String

  /// Required (enforced in LedgerService) for ADJUSTMENT entries; optional
  /// free-text context for all other types.
  reason String?

  relatedDepositId    String?
  deposit             Deposit?    @relation(fields: [relatedDepositId], references: [id], onDelete: SetNull)
  relatedWithdrawalId String?
  withdrawal          Withdrawal? @relation(fields: [relatedWithdrawalId], references: [id], onDelete: SetNull)
  relatedMatchStakeId String?
  matchStake          MatchStake? @relation(fields: [relatedMatchStakeId], references: [id], onDelete: SetNull)

  settlementEntry SettlementEntry?

  providerReference String?

  /// Set only for ADJUSTMENT entries — the admin who authorized it.
  createdByAdminId String?
  createdByAdmin   User?   @relation("LedgerAdjustmentAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([relatedMatchStakeId])
  /// Serves the Phase 8 rolling-window spend query (sum of STAKE_HOLD —
  /// or DEPOSIT — entries for a user within the last N hours) — see
  /// EligibilityService and ADR-023.
  @@index([userId, type, createdAt])
  @@map("ledger_entries")
}

/// Deposit lifecycle. Becomes COMPLETED (and credits the ledger) only
/// through `DepositsService.completeFromProviderEvent`, never from a
/// client-supplied "payment succeeded" claim.
model Deposit {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  amountMinor BigInt
  currency    String @default("SLE")

  status DepositStatus @default(PENDING)

  /// "MANUAL" (default, no live provider) or "MONIME".
  provider          String
  providerReference String?

  /// Client-supplied idempotency key (required header on creation). The
  /// unique constraint below is itself the idempotency mechanism — a
  /// retried create with the same key returns the original row.
  idempotencyKey String

  failureReason String?

  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  ledgerEntries      LedgerEntry[]
  providerEvents     ProviderEvent[]
  providerOperations ProviderOperation[]
  anomalies          PaymentReconciliationAnomaly[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status])
  @@index([providerReference])
  @@map("deposits")
}

/// Withdrawal lifecycle. A hold is created atomically at request time
/// (PENDING_REVIEW); admin approval is required before funds actually
/// leave the system (COMPLETED). See
/// docs/decisions/ADR-012-financial-architecture.md for the state machine.
model Withdrawal {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  amountMinor BigInt
  currency    String @default("SLE")

  status WithdrawalStatus @default(PENDING_REVIEW)

  /// Abstracted payout destination (e.g. mobile money provider + number).
  /// Not identity-verified in Phase 3 — see CLAUDE.md KYC exclusion.
  destinationDetails Json

  idempotencyKey String

  reviewedByAdminId String?
  reviewedByAdmin   User?     @relation("WithdrawalReviewAdmin", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewReason      String?

  providerReference String?
  failureReason     String?

  approvedAt  DateTime?
  rejectedAt  DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  ledgerEntries      LedgerEntry[]
  providerEvents     ProviderEvent[]
  providerOperations ProviderOperation[]
  anomalies          PaymentReconciliationAnomaly[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status])
  @@map("withdrawals")
}

/// Raw record of every inbound payment-provider webhook delivery attempt
/// (valid or not), keyed for idempotent processing of retried deliveries.
/// `payload` must never contain secrets (signing secrets are config, not
/// webhook body content) — see docs/architecture/SECURITY.md.
model ProviderEvent {
  id              String @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json

  status ProviderEventStatus @default(RECEIVED)

  relatedDepositId    String?
  deposit             Deposit?    @relation(fields: [relatedDepositId], references: [id], onDelete: SetNull)
  /// Set for payout-related webhook deliveries (Phase 6) — a deposit
  /// webhook and a withdrawal webhook never both set a relation on the
  /// same row.
  relatedWithdrawalId String?
  withdrawal          Withdrawal? @relation(fields: [relatedWithdrawalId], references: [id], onDelete: SetNull)

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@map("provider_events")
}

// ---------------------------------------------------------------------------
// Phase 4 — Game Platform Core, Matchmaking, Real-Time Multiplayer
//
// Server-authoritative game/match model — see docs/architecture/GAME_ENGINE.md,
// docs/decisions/ADR-014-realtime-command-transport.md, and
// docs/decisions/ADR-015-game-module-architecture.md. `Match.state` is an
// opaque (to the platform) JSON blob owned entirely by the game module
// named in `Match.gameId` — the generic match/command pipeline never
// branches on game type. No relation here ever touches a Phase 3
// financial model.
// ---------------------------------------------------------------------------

enum MatchStatus {
  WAITING
  READY
  ACTIVE
  COMPLETED
  CANCELLED
  /// Reserved for a future non-Match use (e.g. Challenge reuses the same
  /// naming); Match itself currently reaches an expired WAITING match via
  /// CANCELLED + terminationReason=WAITING_TIMEOUT instead of this value.
  EXPIRED
  ABANDONED
}

enum MatchTerminationReason {
  WAITING_TIMEOUT
  CANCELLED_BY_PLAYER
  ABANDONED_DISCONNECT
  /// A participant resigned (Phase 9 — ADR-024). `winnerUserId` is the
  /// opponent; `resultIsDraw` is false.
  RESIGNATION
  /// The current turn-holder's `turnDeadlineAt` elapsed (Phase 9 —
  /// ADR-024). `winnerUserId` is the other participant; `resultIsDraw`
  /// is false.
  TURN_TIMEOUT
  /// Both participants agreed to a draw via the draw-offer/accept
  /// commands (Phase 9 — ADR-024), as distinct from a `null`
  /// `terminationReason` board draw decided by the game's own rules.
  /// `resultIsDraw` is true; `winnerUserId` is null.
  DRAW_AGREED
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// The game catalog. One row per playable game; Phase 4 seeds exactly one
/// (Tic-Tac-Toe). Disabling a game (`enabled = false`) hides it from the
/// catalog without deleting match history that references it.
model Game {
  id          String  @id
  displayName String
  description String
  minPlayers  Int
  maxPlayers  Int
  enabled     Boolean @default(true)
  version     Int     @default(1)
  iconKey     String?

  /// Server-trusted turn-clock length for this game (Phase 9 — see
  /// ADR-024). `null` means no turn timer is enforced for this game.
  /// Lives on the catalog row, not a client-supplied value or an env
  /// var, so it can only change via a migration/admin-equivalent action
  /// — never a request parameter.
  turnTimeoutSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches    Match[]
  challenges Challenge[]

  @@map("games")
}

/// A single match instance. `state`/`stateVersion` are the authoritative,
/// server-only game state — never trust a client-supplied value for any
/// of these fields (see ADR-008). `gameVersion` snapshots `Game.version`
/// at creation so a later rule-version bump never retroactively changes
/// an in-flight or historical match.
model Match {
  id          String @id @default(uuid())
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  gameVersion Int

  status       MatchStatus @default(WAITING)
  stateVersion Int         @default(0)
  state        Json

  winnerUserId String?
  winner       User?   @relation("MatchWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  resultIsDraw Boolean @default(false)

  terminationReason MatchTerminationReason?

  /// The deadline for whoever currently holds the turn (per
  /// `GameModule.currentTurnUserId`) to submit a move, refreshed on
  /// every accepted move and cleared once the match ends. `null` means
  /// no turn timer applies (free play or a game with no configured
  /// timer). A real column, not an in-memory timer — survives API
  /// restarts by construction. See ADR-024.
  turnDeadlineAt DateTime?

  /// A pending draw offer from one participant to the other (Phase 9 —
  /// see ADR-024). An offer is not itself a completed draw; only
  /// `DRAW_ACCEPT` from the *other* participant completes the match.
  pendingDrawOfferByUserId  String?
  pendingDrawOfferBy        User?     @relation("MatchPendingDrawOfferBy", fields: [pendingDrawOfferByUserId], references: [id], onDelete: SetNull)
  pendingDrawOfferExpiresAt DateTime?

  createdAt   DateTime  @default(now())
  readyAt     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  players   MatchPlayer[]
  commands  MatchCommand[]
  challenge Challenge?
  stake     MatchStake?
  disputes  Dispute[]

  @@index([status])
  @@index([gameId])
  @@index([status, turnDeadlineAt])
  @@map("matches")
}

/// One row per participant in a match. `seat` is a stable 0-based index
/// that the game module interprets (e.g. seat 0 = X, seat 1 = O for
/// Tic-Tac-Toe) — the platform itself assigns no meaning to it beyond
/// ordering. `disconnectedAt` is set on WS disconnect and cleared on
/// reconnect; the timeout sweep (`MatchTimeoutService`) is what actually
/// turns a stale disconnect into an ABANDONED match.
model MatchPlayer {
  id      String @id @default(uuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seat Int

  disconnectedAt DateTime?
  leftAt         DateTime?

  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@unique([matchId, seat])
  @@map("match_players")
}

/// Idempotency + audit record for every submitted match command (Phase 4
/// only ever produces `type: "MOVE"`, left open for future command
/// types). `id` is **client-supplied** — the same client-generated id
/// retried after a network failure hits `@@unique([matchId, id])` and
/// returns the originally-stored result instead of reapplying the move.
model MatchCommand {
  id      String
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  payload Json

  resultStatus      String
  rejectionReason   String?
  stateVersionAfter Int?

  createdAt DateTime @default(now())

  @@id([matchId, id])
  @@index([matchId])
  @@map("match_commands")
}

/// A direct player-to-player challenge. Accepting one creates a `Match`
/// (and points `matchId` at it) atomically with the status transition —
/// see `ChallengesService.accept`.
model Challenge {
  id           String @id @default(uuid())
  gameId       String
  game         Game   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  challengerId String
  challenger   User   @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId   String
  opponent     User   @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  status ChallengeStatus @default(PENDING)

  matchId String? @unique
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)

  /// Optional — a challenge with no stake is ordinary free play. Set once
  /// at creation and never mutated (see docs/decisions/ADR-016, "stake
  /// immutability"): accepting commits to exactly this amount.
  stakeAmountMinor BigInt?
  stakeCurrency    String?

  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([status])
  @@index([challengerId])
  @@index([opponentId])
  @@map("challenges")
}

// ---------------------------------------------------------------------------
// Phase 5 — Real-Money Match Stakes, Holds, Prize Pools & Settlement
//
// See docs/decisions/ADR-016-match-financial-architecture.md,
// ADR-017-deterministic-settlement.md, and
// ADR-018-financial-state-machines.md. `MatchStake` is the hold-commitment
// record (one per financially-backed Match, 1:1); `Settlement` is the
// terminal financial outcome (one per MatchStake, 1:1, DB-unique — this
// *is* the exactly-once guarantee), broken down per-party into
// `SettlementEntry` rows for full audit reconstruction. Every money
// movement here still goes through `LedgerService.applyEntry` — this
// phase adds no new way to touch a `Wallet` directly.
// ---------------------------------------------------------------------------

enum MatchStakeStatus {
  PENDING
  HELD
  ACTIVE
  SETTLING
  SETTLED
  REFUNDED
  CANCELLED
  DISPUTED
  FAILED
}

enum SettlementOutcome {
  WIN
  DRAW
  REFUND
  CANCELLED
}

enum SettlementStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SettlementEntryRole {
  WINNER
  LOSER
  DRAW_PARTICIPANT
  REFUND_RECIPIENT
  PLATFORM_FEE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  REFUNDED
  RESOLVED
}

/// The financial commitment attached to a match. Equal-stake is enforced
/// by construction — `stakeAmountMinor` is one value shared by every
/// `MatchStakePlayer`, not a per-player amount. `matchId` is `Restrict`
/// (financial history, like `Wallet`/`Deposit`/`Withdrawal` — never
/// deletable).
model MatchStake {
  id      String @id @default(uuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Restrict)

  currency         String
  stakeAmountMinor BigInt

  status MatchStakeStatus @default(PENDING)

  failureReason String?

  createdAt   DateTime  @default(now())
  heldAt      DateTime?
  cancelledAt DateTime?

  players       MatchStakePlayer[]
  settlement    Settlement?
  ledgerEntries LedgerEntry[]

  @@index([status])
  @@map("match_stakes")
}

/// One row per participant's hold state. `heldAt` is set the instant that
/// specific player's `STAKE_HOLD` ledger entry is applied; the
/// `MatchStake` as a whole reaches `HELD` only once every player row here
/// has a non-null `heldAt`.
model MatchStakePlayer {
  id           String     @id @default(uuid())
  matchStakeId String
  matchStake   MatchStake @relation(fields: [matchStakeId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  heldAt DateTime?

  createdAt DateTime @default(now())

  @@unique([matchStakeId, userId])
  @@map("match_stake_players")
}

/// The one terminal financial outcome for a `MatchStake`. `@unique` on
/// `matchStakeId` is the database-enforced exactly-once guarantee (see
/// `SettlementService` — a second settlement attempt for the same stake
/// always hits this constraint and is treated as a safe, idempotent
/// retry, never a second payout). Pool/fee are captured here as an
/// immutable snapshot even though both are deterministically derivable
/// from `MatchStake`, so a later config change (e.g. a different fee
/// percentage) can never retroactively change what a historical
/// settlement is recorded as having paid.
model Settlement {
  id           String     @id @default(uuid())
  matchStakeId String     @unique
  matchStake   MatchStake @relation(fields: [matchStakeId], references: [id], onDelete: Restrict)

  outcome SettlementOutcome
  status  SettlementStatus  @default(PENDING)

  currency               String
  poolAmountMinor        BigInt
  platformFeeAmountMinor BigInt @default(0)

  failureReason String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  entries SettlementEntry[]

  @@map("settlements")
}

/// One row per money movement a settlement causes — the complete audit
/// trail (section 25/52 of the Phase 5 spec): who, what role, how much,
/// and which exact `LedgerEntry` carried it out. `ledgerEntryId` is
/// `@unique` (one entry, one ledger row) and `SetNull` only as a schema
/// formality — ledger rows are never deleted.
model SettlementEntry {
  id           String     @id @default(uuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  role SettlementEntryRole

  availableDeltaMinor BigInt
  heldDeltaMinor      BigInt

  ledgerEntryId String?      @unique
  ledgerEntry   LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([settlementId])
  /// Serves the Phase 8 rolling-window loss query (sum of LOSER-role
  /// entries for a user within the last N hours) — see
  /// EligibilityService and ADR-023.
  @@index([userId, role, createdAt])
  @@map("settlement_entries")
}

/// Technical foundation for a player disputing a completed match's
/// financial outcome. Opening or reviewing a dispute never itself changes
/// any balance — resolution happens through the same `SettlementService`/
/// `LedgerService` paths as everything else (a compensating transaction,
/// never a mutated history row).
model Dispute {
  id             String @id @default(uuid())
  matchId        String
  match          Match  @relation(fields: [matchId], references: [id], onDelete: Restrict)
  raisedByUserId String
  raisedBy       User   @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)

  reason String
  status DisputeStatus @default(OPEN)

  resolution        String?
  resolvedByAdminId String?
  resolvedByAdmin   User?   @relation("DisputeResolvedBy", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([matchId])
  @@index([status])
  @@map("disputes")
}

// ---------------------------------------------------------------------------
// Phase 6 — Production Payment Integration, Financial Operations, Account
// Security & Responsible-Gaming Foundations
//
// See docs/decisions/ADR-019-production-payments.md (provider
// abstraction/webhook/reconciliation), ADR-020-account-security.md (admin
// session cookies, password reset, MFA), and
// ADR-021-eligibility-and-responsible-gaming.md. None of this changes
// Phase 5 settlement math or ledger-writer exclusivity: `LedgerService`
// remains the only code path that ever touches a `Wallet` balance or
// inserts a `LedgerEntry`. See docs/development/PHASE_6_CHECKLIST.md for
// the verified-vs-unverified Monime API facts this schema is built on.
// ---------------------------------------------------------------------------

enum ProviderOperationKind {
  DEPOSIT_INITIATE
  DEPOSIT_STATUS_CHECK
  PAYOUT_SUBMIT
  PAYOUT_STATUS_CHECK
}

enum ProviderOperationStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// The provider's actual outcome could not be determined (e.g. an HTTP
  /// timeout on submission). Per ADR-019, an UNKNOWN operation is never
  /// retried with a new idempotency key — only resolved by querying the
  /// provider for the status of this exact operation, or by manual
  /// reconciliation.
  UNKNOWN
}

/// One row per outbound call PlayLe makes to a payment provider (deposit
/// initiation, payout submission, and status polls for either). The
/// persisted `providerIdempotencyKey` is what makes a retried submission
/// safe: a retry after a timeout reuses this same key and the provider's
/// own idempotency guarantee (see docs/development/PHASE_6_CHECKLIST.md
/// §0) prevents a duplicate payout — PlayLe never mints a second key for
/// the same operation just because the first attempt's outcome is
/// unknown.
model ProviderOperation {
  id       String                @id @default(uuid())
  provider String
  kind     ProviderOperationKind

  relatedDepositId    String?
  deposit             Deposit?    @relation(fields: [relatedDepositId], references: [id], onDelete: SetNull)
  relatedWithdrawalId String?
  withdrawal          Withdrawal? @relation(fields: [relatedWithdrawalId], references: [id], onDelete: SetNull)

  providerIdempotencyKey String @unique

  status ProviderOperationStatus @default(PENDING)

  requestSnapshot  Json?
  responseSnapshot Json?
  failureReason    String?

  attempts Int @default(1)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([status])
  @@index([relatedDepositId])
  @@index([relatedWithdrawalId])
  @@map("provider_operations")
}

enum PaymentAnomalyType {
  DEPOSIT_CREDITED_WITHOUT_PROVIDER_CONFIRMATION
  DEPOSIT_PROVIDER_CONFIRMED_NOT_CREDITED
  WITHDRAWAL_PROVIDER_PAID_NOT_COMPLETED
  WITHDRAWAL_COMPLETED_WITHOUT_PROVIDER_CONFIRMATION
  DUPLICATE_PROVIDER_REFERENCE
  AMOUNT_MISMATCH
  STUCK_PROCESSING
  ORPHAN_PROVIDER_EVENT
  UNKNOWN_PAYOUT_OUTCOME
  LEDGER_PROVIDER_DRIFT
}

enum PaymentAnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Output of the Phase 6 payment-reconciliation sweep — distinct from
/// Phase 5's match-settlement reconciliation (`ReconciliationService`).
/// Detecting and recording an anomaly here never itself mutates money or
/// historical financial records (see ADR-019); resolution happens only
/// through the ordinary Deposit/Withdrawal/Ledger service paths, recorded
/// back onto this row for audit.
model PaymentReconciliationAnomaly {
  id   String             @id @default(uuid())
  type PaymentAnomalyType

  relatedDepositId    String?
  deposit             Deposit?    @relation(fields: [relatedDepositId], references: [id], onDelete: SetNull)
  relatedWithdrawalId String?
  withdrawal          Withdrawal? @relation(fields: [relatedWithdrawalId], references: [id], onDelete: SetNull)

  details Json

  status PaymentAnomalyStatus @default(OPEN)

  resolvedByAdminId String?
  resolvedByAdmin   User?   @relation("PaymentAnomalyResolvedAdmin", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  resolutionNote    String?

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([type])
  @@map("payment_reconciliation_anomalies")
}

/// A single-use, expiring, hashed password-reset token. The raw token is
/// never persisted (mirrors `RefreshToken.tokenHash` — see
/// `src/auth/token.service.ts`); only its SHA-256 hash is stored.
/// Consuming one revokes every refresh-token session for the user (same
/// policy as `AuthService.changePassword`).
model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  requestIp String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

/// A one-time verification code challenge. `codeHash` is a SHA-256 hash
/// of the short numeric code actually delivered — the raw code is never
/// persisted. `attempts` is incremented on every failed check and
/// enforces a throttle (see `VerificationService`); exceeding it forces a
/// fresh challenge rather than allowing unlimited guesses against one.
model VerificationChallenge {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel VerificationChannel
  purpose VerificationPurpose
  target  String

  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("verification_challenges")
}

/// One row per user with TOTP MFA enrolled (at most one — `userId` is
/// unique; re-enrolling replaces this row rather than creating a second).
/// `secretEncrypted` is the TOTP seed encrypted at rest (see
/// `docs/decisions/ADR-020-account-security.md` for the encryption-key
/// source) — never stored or logged in plaintext. `confirmedAt` is null
/// during enrollment (secret generated, not yet proven by one valid code)
/// — an unconfirmed credential grants no login enforcement, preventing a
/// user from locking themselves out of an incomplete enrollment.
model MfaTotpCredential {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secretEncrypted String

  confirmedAt DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())

  recoveryCodes MfaRecoveryCode[]

  @@map("mfa_totp_credentials")
}

/// Single-use MFA recovery codes, issued as a batch at enrollment
/// confirmation. `codeHash` is a hash of one recovery code; `usedAt` is
/// set the instant one is consumed and it is never usable again.
model MfaRecoveryCode {
  id                  String            @id @default(uuid())
  mfaTotpCredentialId String
  mfaTotpCredential   MfaTotpCredential @relation(fields: [mfaTotpCredentialId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([mfaTotpCredentialId])
  @@map("mfa_recovery_codes")
}

enum ResponsibleGamingRestrictionType {
  SELF_EXCLUSION
  DEPOSIT_LIMIT
  STAKE_LIMIT
  LOSS_LIMIT
  COOLING_OFF
}

enum ResponsibleGamingRestrictionStatus {
  ACTIVE
  EXPIRED
  LIFTED
}

/// A user-initiated or time-bound financial/gaming restriction, enforced
/// centrally by the eligibility policy service (`EligibilityService`) at
/// every financial and stake-forming boundary — never left to individual
/// controllers to check ad hoc. A `SELF_EXCLUSION` row has no `endsAt` and
/// — deliberately, this phase — no admin "lift" endpoint exists anywhere
/// in the codebase; `status` can reach `LIFTED` only for the other
/// restriction types (e.g. a user shortening their own cooling-off via an
/// equally-restrictive new request is still a new row, never an edit of
/// this one — see ADR-021 "no destructive editing of restriction
/// history").
model ResponsibleGamingRestriction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type   ResponsibleGamingRestrictionType
  status ResponsibleGamingRestrictionStatus @default(ACTIVE)

  /// Type-specific configuration, e.g. `{"limitMinor": "50000"}` for a
  /// DEPOSIT_LIMIT/STAKE_LIMIT/LOSS_LIMIT; `{}` for SELF_EXCLUSION/COOLING_OFF.
  config Json

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  liftedAt     DateTime?
  liftedReason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@map("responsible_gaming_restrictions")
}

enum NotificationType {
  DEPOSIT_COMPLETED
  DEPOSIT_FAILED
  WITHDRAWAL_SUBMITTED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_FAILED
  SELF_EXCLUSION_ACTIVATED
  PASSWORD_RESET_REQUESTED
  VERIFICATION_CODE_ISSUED
  /// A stake/deposit was blocked, or a loss limit was reached, by a
  /// Phase 8 rolling-window responsible-gaming check — see
  /// docs/decisions/ADR-023-rolling-window-responsible-gaming.md.
  RESPONSIBLE_GAMING_LIMIT_REACHED
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Transactional outbox for every financial/account-security
/// notification: a row here is always written in the **same** database
/// transaction as the financial mutation or security event it describes
/// (see ADR-019 "notifications must not be emitted before commit"), and a
/// separate dispatcher (polling, like `MatchTimeoutService`) delivers it
/// afterwards via whatever `NotificationDeliveryPort` is configured
/// (`FakeDeliveryAdapter` absent real credentials — see
/// docs/development/PHASE_6_CHECKLIST.md item 6). Delivery failure never
/// rolls back or retries the underlying financial operation.
model NotificationOutbox {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  payload Json

  status   NotificationOutboxStatus @default(PENDING)
  attempts Int                      @default(0)

  failureReason String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status])
  @@map("notification_outbox")
}

enum AdminAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REFRESH
  CSRF_REJECTED
  MFA_ENROLLED
  MFA_DISABLED
  MFA_CHALLENGE_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
}

/// Append-only audit trail for admin-session and account-security
/// events (login/logout/refresh, CSRF rejections, MFA changes, password
/// resets). Separate from the financial `LedgerEntry` audit trail — this
/// one is about *who accessed what*, not money. `adminId` is nullable so
/// a failed login attempt against a nonexistent/non-admin identifier can
/// still be recorded (for brute-force visibility) without a FK to attach
/// it to.
model AdminAuditLog {
  id      String           @id @default(uuid())
  adminId String?
  admin   User?            @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action  AdminAuditAction
  detail  String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("admin_audit_logs")
}
