// PlayLe — Prisma schema
//
// Phase 2 introduces the first real domain models: User identity and
// authentication (refresh token) state. See docs/database/README.md and
// docs/decisions/ADR-011-authentication.md for the reasoning behind the
// shapes below. The full business schema (wallet, ledger, matches, social
// graph, etc.) is still designed in later, dedicated phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/// Core identity record. One row per account. Never return `passwordHash`
/// from an API response — see `src/users/users.service.ts` `toSafeUser`.
model User {
  id          String  @id @default(uuid())
  email       String  @unique
  phoneNumber String? @unique

  username    String  @unique
  displayName String?
  avatarUrl   String?

  passwordHash String

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  dateOfBirth DateTime

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  wallet        Wallet?
  deposits      Deposit[]
  withdrawals   Withdrawal[]

  ledgerAdjustmentsAuthored LedgerEntry[] @relation("LedgerAdjustmentAdmin")
  withdrawalReviewsAuthored Withdrawal[]  @relation("WithdrawalReviewAdmin")

  matchPlayers         MatchPlayer[]
  matchesWon           Match[]       @relation("MatchWinner")
  matchCommands        MatchCommand[]
  challengesSent       Challenge[]   @relation("ChallengeChallenger")
  challengesReceived   Challenge[]   @relation("ChallengeOpponent")

  @@map("users")
}

/// Refresh-token session state, supporting rotation and reuse detection.
/// The raw refresh token is never persisted — only a SHA-256 hash of it
/// (see `src/auth/token.service.ts`). `familyId` groups every token
/// descended from a single login: rotating issues a new row in the same
/// family; presenting an already-revoked token (reuse of a stale token,
/// e.g. a stolen one) revokes the whole family, logging out every device
/// descended from that login.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash      String    @unique
  familyId       String
  replacedByHash String?
  revokedAt      DateTime?

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Phase 3 — Wallet, Ledger & Financial Foundation
//
// Money is always an integer count of minor units (1 SLE = 100 minor units,
// i.e. cents) stored as `BigInt`/Postgres `bigint`. Never a float. See
// docs/decisions/ADR-012-financial-architecture.md for the full reasoning.
//
// The only code path allowed to change a Wallet's balances or insert a
// LedgerEntry is `LedgerService.applyEntry` (apps/api/src/ledger/ledger.service.ts).
// No other service may call `wallet.update(...)` or `ledgerEntry.create(...)`
// directly. Financial relations use `onDelete: Restrict` — a user with any
// financial history can never be deleted, by design.
// ---------------------------------------------------------------------------

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  HOLD
  RELEASE
  REFUND
  ADJUSTMENT
  /// Reserved for the future betting/settlement phase. Never produced by
  /// Phase 3 code — see CLAUDE.md "what not to build yet".
  PRIZE
  /// Reserved for the future betting/settlement phase. Never produced by
  /// Phase 3 code — see CLAUDE.md "what not to build yet".
  PLATFORM_FEE
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  REJECTED
}

/// One unified wallet per user. `availableBalanceMinor` can be spent/
/// withdrawn; `heldBalanceMinor` is reserved (e.g. a pending withdrawal)
/// and cannot. Both are enforced non-negative at the application layer
/// (LedgerService) and at the database layer (CHECK constraints added by
/// hand to the generated migration).
model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  availableBalanceMinor BigInt @default(0)
  heldBalanceMinor      BigInt @default(0)
  currency              String @default("SLE")

  ledgerEntries LedgerEntry[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

/// Immutable, append-only financial audit log. Every row is one atomic
/// balance-affecting event. `availableDeltaMinor`/`heldDeltaMinor` are
/// signed and may both be non-zero in the same row (e.g. a HOLD moves
/// money from available to held in one event). `*BalanceAfterMinor` is a
/// snapshot of the resulting wallet state, so a row is self-describing
/// without needing to replay history. Never updated or deleted after
/// creation — there is deliberately no update/delete method for this
/// model anywhere in the service layer.
model LedgerEntry {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  userId   String

  type LedgerEntryType

  availableDeltaMinor BigInt
  heldDeltaMinor      BigInt

  availableBalanceAfterMinor BigInt
  heldBalanceAfterMinor      BigInt

  currency String

  /// Required (enforced in LedgerService) for ADJUSTMENT entries; optional
  /// free-text context for all other types.
  reason String?

  relatedDepositId    String?
  deposit             Deposit?    @relation(fields: [relatedDepositId], references: [id], onDelete: SetNull)
  relatedWithdrawalId String?
  withdrawal          Withdrawal? @relation(fields: [relatedWithdrawalId], references: [id], onDelete: SetNull)

  providerReference String?

  /// Set only for ADJUSTMENT entries — the admin who authorized it.
  createdByAdminId String?
  createdByAdmin   User?   @relation("LedgerAdjustmentAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@map("ledger_entries")
}

/// Deposit lifecycle. Becomes COMPLETED (and credits the ledger) only
/// through `DepositsService.completeFromProviderEvent`, never from a
/// client-supplied "payment succeeded" claim.
model Deposit {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  amountMinor BigInt
  currency    String @default("SLE")

  status DepositStatus @default(PENDING)

  /// "MANUAL" (default, no live provider) or "MONIME".
  provider          String
  providerReference String?

  /// Client-supplied idempotency key (required header on creation). The
  /// unique constraint below is itself the idempotency mechanism — a
  /// retried create with the same key returns the original row.
  idempotencyKey String

  failureReason String?

  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  ledgerEntries  LedgerEntry[]
  providerEvents ProviderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status])
  @@index([providerReference])
  @@map("deposits")
}

/// Withdrawal lifecycle. A hold is created atomically at request time
/// (PENDING_REVIEW); admin approval is required before funds actually
/// leave the system (COMPLETED). See
/// docs/decisions/ADR-012-financial-architecture.md for the state machine.
model Withdrawal {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  amountMinor BigInt
  currency    String @default("SLE")

  status WithdrawalStatus @default(PENDING_REVIEW)

  /// Abstracted payout destination (e.g. mobile money provider + number).
  /// Not identity-verified in Phase 3 — see CLAUDE.md KYC exclusion.
  destinationDetails Json

  idempotencyKey String

  reviewedByAdminId String?
  reviewedByAdmin   User?   @relation("WithdrawalReviewAdmin", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewReason      String?

  providerReference String?
  failureReason     String?

  approvedAt  DateTime?
  rejectedAt  DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status])
  @@map("withdrawals")
}

/// Raw record of every inbound payment-provider webhook delivery attempt
/// (valid or not), keyed for idempotent processing of retried deliveries.
/// `payload` must never contain secrets (signing secrets are config, not
/// webhook body content) — see docs/architecture/SECURITY.md.
model ProviderEvent {
  id              String @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json

  status ProviderEventStatus @default(RECEIVED)

  relatedDepositId String?
  deposit          Deposit? @relation(fields: [relatedDepositId], references: [id], onDelete: SetNull)

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@map("provider_events")
}

// ---------------------------------------------------------------------------
// Phase 4 — Game Platform Core, Matchmaking, Real-Time Multiplayer
//
// Server-authoritative game/match model — see docs/architecture/GAME_ENGINE.md,
// docs/decisions/ADR-014-realtime-command-transport.md, and
// docs/decisions/ADR-015-game-module-architecture.md. `Match.state` is an
// opaque (to the platform) JSON blob owned entirely by the game module
// named in `Match.gameId` — the generic match/command pipeline never
// branches on game type. No relation here ever touches a Phase 3
// financial model.
// ---------------------------------------------------------------------------

enum MatchStatus {
  WAITING
  READY
  ACTIVE
  COMPLETED
  CANCELLED
  /// Reserved for a future non-Match use (e.g. Challenge reuses the same
  /// naming); Match itself currently reaches an expired WAITING match via
  /// CANCELLED + terminationReason=WAITING_TIMEOUT instead of this value.
  EXPIRED
  ABANDONED
}

enum MatchTerminationReason {
  WAITING_TIMEOUT
  CANCELLED_BY_PLAYER
  ABANDONED_DISCONNECT
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// The game catalog. One row per playable game; Phase 4 seeds exactly one
/// (Tic-Tac-Toe). Disabling a game (`enabled = false`) hides it from the
/// catalog without deleting match history that references it.
model Game {
  id          String  @id
  displayName String
  description String
  minPlayers  Int
  maxPlayers  Int
  enabled     Boolean @default(true)
  version     Int     @default(1)
  iconKey     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches    Match[]
  challenges Challenge[]

  @@map("games")
}

/// A single match instance. `state`/`stateVersion` are the authoritative,
/// server-only game state — never trust a client-supplied value for any
/// of these fields (see ADR-008). `gameVersion` snapshots `Game.version`
/// at creation so a later rule-version bump never retroactively changes
/// an in-flight or historical match.
model Match {
  id          String @id @default(uuid())
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  gameVersion Int

  status       MatchStatus @default(WAITING)
  stateVersion Int         @default(0)
  state        Json

  winnerUserId String?
  winner       User?   @relation("MatchWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  resultIsDraw Boolean @default(false)

  terminationReason MatchTerminationReason?

  createdAt   DateTime  @default(now())
  readyAt     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  players  MatchPlayer[]
  commands MatchCommand[]
  challenge Challenge?

  @@index([status])
  @@index([gameId])
  @@map("matches")
}

/// One row per participant in a match. `seat` is a stable 0-based index
/// that the game module interprets (e.g. seat 0 = X, seat 1 = O for
/// Tic-Tac-Toe) — the platform itself assigns no meaning to it beyond
/// ordering. `disconnectedAt` is set on WS disconnect and cleared on
/// reconnect; the timeout sweep (`MatchTimeoutService`) is what actually
/// turns a stale disconnect into an ABANDONED match.
model MatchPlayer {
  id      String @id @default(uuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seat Int

  disconnectedAt DateTime?
  leftAt         DateTime?

  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@unique([matchId, seat])
  @@map("match_players")
}

/// Idempotency + audit record for every submitted match command (Phase 4
/// only ever produces `type: "MOVE"`, left open for future command
/// types). `id` is **client-supplied** — the same client-generated id
/// retried after a network failure hits `@@unique([matchId, id])` and
/// returns the originally-stored result instead of reapplying the move.
model MatchCommand {
  id      String
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  payload Json

  resultStatus      String
  rejectionReason   String?
  stateVersionAfter Int?

  createdAt DateTime @default(now())

  @@id([matchId, id])
  @@index([matchId])
  @@map("match_commands")
}

/// A direct player-to-player challenge. Accepting one creates a `Match`
/// (and points `matchId` at it) atomically with the status transition —
/// see `ChallengesService.accept`.
model Challenge {
  id            String @id @default(uuid())
  gameId        String
  game          Game   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  challengerId  String
  challenger    User   @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId    String
  opponent      User   @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  status ChallengeStatus @default(PENDING)

  matchId String? @unique
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)

  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([status])
  @@index([challengerId])
  @@index([opponentId])
  @@map("challenges")
}
