# Copy to `.env` for local development. Never commit the real `.env` file.

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed origins for CORS (e.g. the admin app and
# local mobile dev tooling).
CORS_ORIGINS=http://localhost:3001

# PostgreSQL (matches infrastructure/docker/docker-compose.yml defaults)
DATABASE_URL=postgresql://playle:playle_dev_password@localhost:5432/playle_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting (requests per TTL window, milliseconds)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Access/refresh token strategy — see docs/decisions/ADR-011-authentication.md.
# Generate a real secret with, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Product age gate (not legal/KYC age verification — see ADR-011)
AUTH_MIN_AGE_YEARS=16

# Stricter rate limit for register/login specifically (credential-guessing
# protection). Raise this only for automated test runs, never production.
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000

# Encrypts MFA TOTP secrets at rest (AES-256-GCM). Required — generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=replace-with-a-generated-64-character-hex-string

# Admin dashboard session cookies — see
# docs/decisions/ADR-020-account-security.md. Reuses the same
# access/refresh-token machinery as every other client; only the
# transport (httpOnly cookie vs. JSON body) differs.
# Only ever "true" in a real deployed (HTTPS) environment — leave
# "false" for local dev/test, where cookies must work over plain HTTP.
ADMIN_SESSION_SECURE_COOKIES=false
# Keep in sync with JWT_ACCESS_TTL's default (15m) unless changed.
ADMIN_SESSION_ACCESS_COOKIE_TTL_MS=900000

# Payment provider — see docs/decisions/ADR-013-payment-provider-abstraction.md,
# ADR-019-production-payments.md, and docs/development/MONIME_SETUP.md.
# "manual" (default) makes no real network call. Setting this to "monime"
# makes real HTTP calls to the Monime API (Payment Codes for deposits,
# Payouts for withdrawals) once MONIME_API_KEY/MONIME_SPACE_ID are set —
# a mon_test_... token is always safe to use; a live (mon_...) token
# additionally requires MONIME_LIVE_PAYMENTS_ENABLED=true (see
# "production activation guardrails" in
# docs/development/PHASE_6_CHECKLIST.md). Inbound webhook signature
# verification stays fail-closed (always rejected) regardless of this
# setting until the exact Monime-Signature canonical string is verified
# — see the checklist's open items.
PAYMENTS_PROVIDER=manual
# Never commit real values.
MONIME_API_KEY=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=
MONIME_BASE_URL=https://api.monime.io
# Optional pin, e.g. caph.2025-08-23. Leave unset to use Monime's current default.
MONIME_API_VERSION=
MONIME_HTTP_TIMEOUT_MS=10000
# Must be explicitly "true" before a *live* (non mon_test_) Monime token
# is ever actually used to make a real payment-provider call.
MONIME_LIVE_PAYMENTS_ENABLED=false

# Minimum deposit/withdrawal, in minor units (1 SLE = 100 minor units).
# Le5 = 500.
WALLET_MIN_DEPOSIT_MINOR=500
WALLET_MIN_WITHDRAWAL_MINOR=500

# Rate limit for deposit/withdrawal creation specifically.
PAYMENTS_THROTTLE_LIMIT=10
PAYMENTS_THROTTLE_TTL_MS=60000

# Game platform — see docs/decisions/ADR-015-game-module-architecture.md.
# Rate limit for matchmaking/challenge/command endpoints.
MATCHES_THROTTLE_LIMIT=30
MATCHES_THROTTLE_TTL_MS=60000
# How long a direct challenge stays PENDING before it auto-expires.
CHALLENGE_EXPIRY_MS=120000
# How long a disconnected player's match waits before the other player
# is awarded a forfeit win (see MatchTimeoutService).
MATCH_ABANDON_GRACE_MS=30000
# How often the periodic timeout sweep runs (expired challenges/waiting
# matches, abandoned matches).
MATCH_TIMEOUT_SWEEP_INTERVAL_MS=10000

# Match stakes & settlement — see
# docs/decisions/ADR-016-match-financial-architecture.md. Master real-money
# gate: stays "false" everywhere except an environment that has explicitly
# decided to go live. Automated tests set this to "true" to exercise the
# real engine against test wallets.
REAL_MONEY_GAMING_ENABLED=false
# A SECOND, independent gate (see ADR-021-eligibility-and-responsible-gaming.md)
# — real-money gaming never actually runs unless this is ALSO "true".
# This flag exists so the owner records that an actual, legally-approved
# eligibility policy (age/jurisdiction/KYC) has been configured — never
# set it to "true" just to make REAL_MONEY_GAMING_ENABLED "work"; this
# codebase cannot make that legal determination for you.
ELIGIBILITY_POLICY_CONFIGURED=false
# Separate from AUTH_MIN_AGE_YEARS — identity eligibility and real-money
# eligibility are different concepts (see ADR-016). The existing age
# gate of 16 is NOT proof that a 16-year-old may lawfully participate in
# real-money gaming in any given jurisdiction — this default (18) is a
# conservative placeholder, not a legal determination; see ADR-021.
REAL_MONEY_MINIMUM_AGE=18
# Minimum/maximum stake, in minor units (1 SLE = 100 minor units).
MINIMUM_STAKE_MINOR=100
MAXIMUM_STAKE_MINOR=1000000
# PlayLe's product fee on the prize pool of a completed win/draw match —
# not a government tax (see ADR-016). fee = floor(pool * pct / 100).
PLATFORM_FEE_PERCENTAGE=10
# How long both players have to confirm their stake before the match is
# cancelled and any already-held stake is refunded.
STAKE_COMMIT_TIMEOUT_MS=60000
# Rate limit for stake/dispute endpoints specifically.
STAKES_THROTTLE_LIMIT=30
STAKES_THROTTLE_TTL_MS=60000
