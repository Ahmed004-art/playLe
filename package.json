{
  "name": "playle",
  "version": "0.1.0",
  "private": true,
  "description": "PlayLe - Sierra Leone-first social gaming platform (monorepo root)",
  "workspaces": [
    "apps/api",
    "apps/admin",
    "packages/shared",
    "packages/config"
  ],
  "scripts": {
    "postinstall": "npm run build:shared",
    "build:shared": "npm run build --workspace=packages/shared",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:api": "npm run build --workspace=apps/api",
    "build:admin": "npm run build --workspace=apps/admin",
    "build": "npm run build:shared && npm run build:api && npm run build:admin",
    "test:api": "npm run test --workspace=apps/api",
    "test:admin": "npm run test --workspace=apps/admin",
    "test": "npm run test:api && npm run test:admin",
    "lint:api": "npm run lint --workspace=apps/api",
    "lint:admin": "npm run lint --workspace=apps/admin",
    "lint": "npm run lint:api && npm run lint:admin",
    "typecheck:api": "npm run typecheck --workspace=apps/api",
    "typecheck:admin": "npm run typecheck --workspace=apps/admin",
    "typecheck": "npm run typecheck:api && npm run typecheck:admin",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\"",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:restart": "npm run docker:down && npm run docker:up",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f infrastructure/docker/docker-compose.yml down -v && npm run docker:up"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
